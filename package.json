{
	"name": "pi-cursor-oauth",
	"version": "0.2.0",
	"description": "Cursor OAuth provider extension for pi-coding-agent",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/index.js",
		"dist/index.d.ts"
	],
	"scripts": {
		"build": "bun run clean && bun build src/index.ts --outdir dist --target node --format esm --external @bufbuild/protobuf --external @mariozechner/pi-ai --external @mariozechner/pi-coding-agent && tsc -p tsconfig.build.json",
		"build:types": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist *.tgz",
		"check": "bun run typecheck && bun run knip && bun run lint && AGENT=1 bun test --coverage",
		"check:ci": "bun run typecheck && bun run knip && bun run lint:ci && AGENT=1 bun test --coverage --coverage-reporter=lcov && bun run build",
		"lint": "biome check --write .",
		"lint:ci": "biome ci .",
		"typecheck": "tsc --noEmit",
		"knip": "knip --production",
		"prepack": "npm run build",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"knip": {
		"exclude": [
			"exports",
			"types"
		],
		"ignore": [
			"tests/**",
			".release-tools/**"
		]
	},
	"keywords": [
		"pi-package"
	],
	"author": {
		"name": "J Liew",
		"email": "jliew@420024lab.com"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenryu42/pi-cursor-oauth.git"
	},
	"bugs": {
		"url": "https://github.com/kenryu42/pi-cursor-oauth/issues"
	},
	"homepage": "https://github.com/kenryu42/pi-cursor-oauth#readme",
	"peerDependencies": {
		"@mariozechner/pi-ai": "*",
		"@mariozechner/pi-coding-agent": "*"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.11.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@mariozechner/pi-ai": "0.62.0",
		"@mariozechner/pi-coding-agent": "0.62.0",
		"@types/bun": "^1.3.11",
		"husky": "^9.1.7",
		"knip": "^6.0.3",
		"lint-staged": "^16.4.0",
		"release-tools": "github:kenryu42/release-tools",
		"typescript": "5.9.3"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"trustedDependencies": [
		"koffi",
		"protobufjs",
		"release-tools"
	]
}
